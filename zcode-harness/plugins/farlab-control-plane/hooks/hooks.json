{
  "description": "FAR-Lab frontier control hooks: compact session state, destructive-operation safety, repeated-failure discipline and premature-completion stop guard.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session-context.mjs",
              "true"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/destructive-guard.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/failure-discipline.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop-guard.mjs",
              "mission_strict",
              "true"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
