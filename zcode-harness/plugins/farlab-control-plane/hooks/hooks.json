{
  "description": "FAR-Lab deterministic session context, destructive-command safety and failure-discipline hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session-context.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/destructive-guard.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/failure-discipline.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
