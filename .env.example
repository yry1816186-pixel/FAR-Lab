# FAR-Lab environment configuration
# Copy to .env and fill in at least one live model-provider key.
# Real environment variables always win over values in this file.

# === Model provider keys (at least one required for live research runs) ===
ZAI_API_KEY=                    # Zhipu GLM (default provider, anthropic-compatible wire)
DASHSCOPE_API_KEY=              # Alibaba DashScope / Qwen (competition route)
# ZHIPU_API_KEY=                # legacy zai key name — still honored if ZAI_API_KEY unset

# === Optional: provider selection & tuning ===
# FARLAB_MODEL_PROVIDER=zai     # default model route: zai | dashscope
# FARLAB_ZAI_MODEL=glm-4.6
# FARLAB_ZAI_BASE_URL=https://open.bigmodel.cn/api/anthropic
# FARLAB_DATA_DIR=.far-run      # database + artifacts root (gitignored)
# PORT=3196                     # HTTP API / web workbench port (npm run serve)
# HOST=127.0.0.1                # server bind address
# FARLAB_LEASE_TTL_MS=240000    # run lease TTL
# FARLAB_STAGE_CONCURRENCY=3    # max concurrent sub-tasks per stage

# === Optional: literature sources (polite pool / higher rate limits) ===
# OPENALEX_API_KEY=
# OPENALEX_MAILTO=you@example.com
# CROSSREF_MAILTO=you@example.com

# === Optional: Zotero local-library bridge ===
# FARLAB_ZOTERO_URL=http://localhost:23119   # Zotero desktop local API base

# === Disable .env hydration entirely (hermetic / keyless runs) ===
# FAR_DOTENV=off
