# =============================================================================
# FAR-Lab Environment Variables (TEMPLATE ONLY — NO REAL SECRETS)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: .env is gitignored. Never commit .env or any file containing real
#          API keys, tokens, or passwords. See SECURITY.md for full policy.
# =============================================================================

# --- Competition Profile: Aliyun Bailian / DashScope ---
# Required only for competition_aliyun_qwen adapter.
# Core gates (offline replay) run WITHOUT this key.
DASHSCOPE_API_KEY=

# --- Optional: Override default endpoints ---
# COMPETITION_BASE_URL=
# OPENAI_COMPATIBLE_BASE_URL=

# --- Optional: Server configuration ---
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# --- Optional: Node 24 compile cache ---
# Node ≥24 writes V8 compile cache to `0/` / `frontend/0/` on every run when unset.
# These are gitignored (safe) but recreated on each run; set to 0 to disable:
# NODE_COMPILE_CACHE=0
